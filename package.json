{
  "name": "dilliznt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src/",
    "dev": "next dev -H 0.0.0.0 --port 3029",
    "build": "next build",
    "start": "concurrently --kill-others --names web,worker --prefix-colors blue,green \"next start --port 3029\" \"node --import tsx scripts/worker.ts\"",
    "start:server": "next start --port 3029",
    "start:worker": "node --import tsx --env-file=.env scripts/worker.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .next",
    "dev:worker": "tsx scripts/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:onboard": "tsx scripts/db-onboard.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
