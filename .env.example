# Coznt — environment variables
#
# Copy to .env and fill in values. Never commit .env.

# --- Core ------------------------------------------------------------

# Postgres connection. Worker, web, and migrations all read this.
DATABASE_URL=postgresql://user:pass@localhost:5432/coznt

# Public URL of the deployed app. Used for absolute links in OG images,
# email content, share links, etc.
NEXT_PUBLIC_APP_URL=http://localhost:3029

# --- Auth ------------------------------------------------------------

BETTER_AUTH_BASE_URL=http://localhost:3029

# Better-auth session signing key. ALSO used as the HMAC key for the
# /opportunities slug derivation (src/lib/anonymize/slug.ts).
# Rotating this invalidates every public role URL — bookmarks, OG image
# cache, sitemap entries, referral links. Plan accordingly.
BETTER_AUTH_SECRET=

# Comma-separated list of admin user ids (auth.user.id). Used for impersonation
# / superuser-only routes.
ADMIN_USER_IDS=

# --- Storage ---------------------------------------------------------

# Local-disk fallback when S3_* aren't set. Resumes, attachments, etc.
STORAGE_PATH=./.storage

# S3-compatible object storage (optional; takes precedence over STORAGE_PATH).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_KEY_ID=
S3_KEY_SECRET=

# Encryption key for OAuth tokens stored in oauth_connections.
# 32 bytes hex (e.g. `openssl rand -hex 32`). Rotating breaks all stored tokens.
INTEGRATION_ENCRYPTION_KEY=

# --- AI --------------------------------------------------------------

# Models used by `generate()`. These are required; the app does not provide
# code fallbacks. Override per-agent in the agent definition when needed.
# Valid values: see ModelId union in src/lib/ai/index.ts.
DEFAULT_MODEL=openai/gpt-oss-120b
SMALL_MODEL=openai/gpt-oss-20b
AGENT_MODEL=llama-3.3-70b-versatile

# Required when DEFAULT_MODEL / SMALL_MODEL / AGENT_MODEL is a Groq-served model.
# Get one at https://console.groq.com/keys.
GROQ_API_KEY=

# --- Integrations ----------------------------------------------------

# Google OAuth (calendar, gmail).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Server-side Gmail sender (from address).
GMAIL_USER=
APP_FROM_EMAIL=

# GitHub OAuth (sign-in).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App (Milestone A — execution gate + outcome assessors).
# Created once per environment in https://github.com/settings/apps (or
# https://github.com/organizations/<org>/settings/apps for an org-owned App).
# See docs/github-app-setup.md for the install walkthrough.
COZNT_GITHUB_APP_ID=
# Paste the PEM body; literal `\n` is accepted in place of newlines so the
# key fits in a single env var.
COZNT_GITHUB_APP_PRIVATE_KEY=
# Match what's configured under the App's "Webhook secret" field.
# When set, /api/v1/webhooks/github verifies the X-Hub-Signature-256 header
# instead of demanding a bearer API key.
COZNT_GITHUB_WEBHOOK_SECRET=
# Optional — used only by `scripts/assess-outcomes.ts` to attribute deploy
# outcomes from commit SHAs when the binding hasn't recorded an
# installation id yet.
COZNT_TEST_INSTALLATION_ID=

# LinkedIn OAuth (sign-in / candidate import).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# LiveKit (interview rooms).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=

# reCAPTCHA (sign-up bot defense).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Worker ----------------------------------------------------------

WORKER_BATCH_SIZE=5
WORKER_POLL_INTERVAL_MS=2000

# --- Logging ---------------------------------------------------------

LOG_LEVEL=info
LOG_FORMAT=pretty
# Set to "1" to silence all logs (used by tests).
LOG_NONE=

# --- Seed (dev only) -------------------------------------------------

SEED_ADMIN_EMAIL=admin@local
SEED_ADMIN_PASSWORD=demo123!
SEED_ADMIN_NAME=Admin

# --- E2E (test only) -------------------------------------------------

TEST_EMAIL_BASE=e2e
