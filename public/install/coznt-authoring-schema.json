{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coznt.dev/install/coznt-authoring-schema.json",
  "title": "Coznt — `.agents/` authoring frontmatter",
  "description": "Frontmatter shapes for `.agents/skills/*.md`, `.agents/rules/*.md`, and `.agents/plans/<kind>/*.md`. Generated from src/lib/authoring/schemas.ts.",
  "$defs": {
    "skillFrontmatter": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string"
        },
        "requiredLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "riskClass": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "conservative",
            "balanced",
            "thorough"
          ]
        },
        "triggers": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "planKind": {
                    "type": "string",
                    "enum": [
                      "epic",
                      "feature",
                      "story",
                      "spec",
                      "adr",
                      "test_plan",
                      "release_plan",
                      "risk_register",
                      "incident"
                    ]
                  },
                  "transitionTo": {
                    "type": "string",
                    "enum": [
                      "draft",
                      "in_review",
                      "approved",
                      "in_progress",
                      "completed",
                      "rejected",
                      "changes_requested",
                      "cancelled"
                    ]
                  }
                },
                "required": [
                  "planKind",
                  "transitionTo"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "webhook": {
                    "type": "string",
                    "enum": [
                      "pr_opened",
                      "pr_synchronize",
                      "pr_closed",
                      "issue_opened",
                      "deployment_status"
                    ]
                  },
                  "pathGlobs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "webhook"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "slug",
        "name",
        "description"
      ],
      "additionalProperties": false
    },
