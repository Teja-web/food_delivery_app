{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],

    "noEmit": true,
    "rootDir": "./src",

    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/cli/**/*.ts",
    "src/mcp/**/*.ts",
    "src/lib/agent-context/host-config.ts",
    "src/lib/agent-context/version.ts"
  ]
}
