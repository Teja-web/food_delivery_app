{
  "name": "coznt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src/",
    "lint:choreographies": "tsx scripts/smoke/lint-choreographies.ts --warn-missing",
    "dev": "next dev -H 0.0.0.0 --port 3029",
    "prebuild": "tsx scripts/build/mcp-pack.ts && tsx scripts/build/cli-pack.ts && tsx scripts/build/prompt-hook-pack.ts",
    "build": "next build",
    "start": "concurrently --kill-others --names web,worker --prefix-colors blue,green \"next start --port 3029\" \"node --import tsx src/worker.ts\"",
    "start:server": "next start --port 3029",
    "start:worker": "node --import tsx --env-file=.env src/worker.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .next",
    "dev:worker": "tsx src/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:setup": "tsx scripts/db/setup.ts",
    "db:onboard": "tsx scripts/db/onboard.ts",
    "db:reset": "tsx scripts/db/reset.ts",
    "assess-outcomes": "tsx scripts/ops/assess-outcomes.ts",
    "smoke:audit-chain": "tsx scripts/smoke/audit-chain.ts",
    "verify-evidence-packet": "tsx scripts/smoke/verify-evidence-packet.ts",
    "backfill-mttr": "tsx scripts/ops/backfill-mttr.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "mcp": "tsx src/mcp/bin.ts",
    "mcp:build": "tsc -p tsconfig.mcp.json && chmod +x dist/mcp/bin.js",
    "mcp:pack": "tsx scripts/build/mcp-pack.ts",
    "cli": "tsx src/cli/cli.ts",
    "cli:build": "tsc -p tsconfig.cli.json && chmod +x dist/cli/cli.js",
    "cli:pack": "tsx scripts/build/cli-pack.ts"
  },
  "bin": {
    "coznt-mcp": "./src/mcp/bin.ts",
    "coznt": "./src/cli/cli.ts"
  },
  "dependencies": {
    "@ai-sdk/groq": "^3.0.33",
    "@ai-sdk/openai": "^3.0.50",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/rest": "^22.0.1",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "ai": "^6.0.146",
    "better-auth": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^9.2.1",
    "dedent": "^1.5.3",
    "drizzle-orm": "^0.45.2",
    "groq-sdk": "^1.1.2",
    "jose": "^6.0.11",
    "lucide-react": "^1.7.0",
    "marked": "^18.0.3",
    "markitdown-ts": "^0.0.10",
    "nanoid": "^5.1.7",
    "next": "^16.2.2",
    "next-themes": "^0.4.6",
    "node-sql-parser": "^5.4.0",
    "pg": "^8.20.0",
    "postcss": "^8.5.6",
    "postcss-load-config": "^6.0.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.2.9",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "eslint-plugin-react": "^7.37.5",
    "tailwindcss": "^4.1.18",
    "tar": "^7.5.15",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5"
  }
}
